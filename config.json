{
  "port": 9999,
  "vision_route": {
    "provider": "opencode",
    "model": "gemini-3.5-flash",
    "temperature": 0
  },
  "providers": {
    "nvidia": {
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key": "${NVIDIA_NIM_API_KEY}"
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "api_key": "${OPENROUTER_API_KEY}"
    },
    "opencode": {
      "base_url": "https://opencode.ai/zen/v1",
      "api_key": "${OPENCODE_API_KEY}"
    },
    "cloudflare": {
      "base_url": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
      "api_key": "${CLOUDFLARE_API_TOKEN}"
    }
  },
  "routes": {
    "opus": {
      "system_prepend": "@system_prompts/Opus",
      "model": "z-ai/glm-5.2",
      "provider": "nvidia",
      "temperature": 1,
      "top_p": 0.95,
      "max_tokens": 131072,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "vision": true,
      "toolcalling": true,
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Opus",
          "model": "minimaxai/minimax-m3",
          "provider": "nvidia",
          "temperature": 1,
          "top_p": 0.95,
          "max_tokens": 131072,
          "extra_body": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "vision": true,
          "stream": true
        }
      ]
    },
    "sonnet": {
      "system_prepend": "@system_prompts/Sonnet",
      "provider": "opencode",
      "model": "big-pickle",
      "temperature": 0,
      "top_p": 0.95,
      "max_tokens": 48000,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Sonnet",
          "provider": "nvidia",
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "temperature": 1,
          "top_p": 0.95,
          "max_tokens": 48000,
          "stream": true
        }
      ]
    },
    "haiku": {
      "system_prepend": "@system_prompts/Haiku",
      "provider": "nvidia",
      "model": "stepfun-ai/step-3.7-flash",
      "temperature": 1,
      "top_p": 0.95,
      "max_tokens": 26000,
      "stream": true,
      "vision": true
    }
  },
  "aliases": {
    "anthropic/claude-opus": {
      "system_prepend": "@system_prompts/Opus",
      "model": "z-ai/glm-5.2",
      "provider": "nvidia",
      "temperature": 1,
      "top_p": 0.95,
      "max_tokens": 131072,
      "vision": true,
      "toolcalling": true,
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Opus",
          "model": "minimaxai/minimax-m3",
          "provider": "nvidia",
          "temperature": 1,
          "top_p": 0.95,
          "max_tokens": 131072,
          "vision": true,
          "stream": true
        }
      ]
    },
    "sonnet": {
      "system_prepend": "@system_prompts/Sonnet",
      "provider": "opencode",
      "model": "big-pickle",
      "temperature": 0,
      "top_p": 0.95,
      "max_tokens": 48000,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Sonnet",
          "provider": "nvidia",
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "temperature": 1,
          "top_p": 0.95,
          "max_tokens": 48000,
          "stream": true
        }
      ]
    },
    "anthropic/claude-haiku": {
      "system_prepend": "@system_prompts/Haiku",
      "provider": "nvidia",
      "model": "stepfun-ai/step-3.7-flash",
      "temperature": 1,
      "top_p": 0.95,
      "max_tokens": 26000,
      "vision": true,
      "stream": true
    }
  }
}