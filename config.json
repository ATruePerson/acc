      "provider": "openrouter",
      "model": "poolside/laguna-s-2.1:free",
      "reasoning": {
        "minimal": {},
        "high": {
          "effort": "high"
        }
      },
      "tool_call_support": true,
      "streaming_support": true,
      "image_input_support": false,
      "file_input_support": false,
      "max_context": 1048576,
      "max_output": 32768,
      "enabled": true
    },
    "codex-step-3.7-flash": {
      "display_name": "Step 3.7 Flash (NVIDIA)",
