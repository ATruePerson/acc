{
  "port": 9999,
  "providers": {
    "nvidia": {
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key": "${NVIDIA_NIM_API_KEY}"
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "api_key": "${OPENROUTER_API_KEY}"
    },
    "opencode": {
      "base_url": "https://opencode.ai/zen/v1",
      "api_key": "${OPENCODE_API_KEY}"
    },
    "cloudflare": {
      "base_url": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
      "api_key": "${CLOUDFLARE_API_TOKEN}"
    }
  },
  "routes": {
    "opus": {
      "system_prepend": "@system_prompts/Opus",
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "provider": "nvidia",
      "temperature": 0.3,
      "top_p": 0.95,
      "max_tokens": 48000,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Opus",
          "model": "deepseek-ai/deepseek-v4-pro",
          "provider": "nvidia",
          "temperature": 0.3,
          "top_p": 0.95,
          "max_tokens": 48000,
          "extra_body": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "stream": true
        }
      ]
    },
    "sonnet": {
      "system_prepend": "@system_prompts/Sonnet",
      "provider": "opencode",
      "model": "big-pickle",
      "temperature": 1.5,
      "top_p": 0.95,
      "max_tokens": 48000,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Sonnet",
          "provider": "nvidia",
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "temperature": 1.5,
          "top_p": 0.95,
          "max_tokens": 48000,
          "extra_body": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "stream": true
        }
      ]
    },
    "haiku": {
      "system_prepend": "@system_prompts/Haiku",
      "provider": "nvidia",
      "model": "stepfun-ai/step-3.7-flash",
      "temperature": 1.0,
      "top_p": 0.95,
      "max_tokens": 16000,
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Haiku",
          "provider": "nvidia",
          "model": "minimaxai/minimax-m3",
          "temperature": 1.0,
          "top_p": 0.95,
          "max_tokens": 16000,
          "stream": true
        }
      ]
    }
  },
  "aliases": {
    "anthropic/claude-opus": {
      "system_prepend": "@system_prompts/Opus",
      "model": "deepseek-ai/deepseek-v4-flash",
      "provider": "nvidia",
      "temperature": 0.3,
      "top_p": 0.95,
      "max_tokens": 98000,
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Opus",
          "model": "qwen/qwen3.5-397b-a17b",
          "provider": "nvidia",
          "temperature": 0.3,
          "top_p": 0.95,
          "max_tokens": 98000,
          "stream": true
        }
      ]
    },
    "anthropic/claude-sonnet": {
      "system_prepend": "@system_prompts/Sonnet",
      "model": "big-pickle",
      "provider": "opencode",
      "temperature": 1.5,
      "top_p": 0.95,
      "max_tokens": 48000,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Sonnet",
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "provider": "nvidia",
          "temperature": 1.5,
          "top_p": 0.95,
          "max_tokens": 48000,
          "stream": true
        }
      ]
    },
    "anthropic/claude-haiku": {
      "system_prepend": "@system_prompts/Haiku",
      "model": "stepfun-ai/step-3.7-flash",
      "provider": "nvidia",
      "temperature": 1.0,
      "top_p": 0.95,
      "max_tokens": 26000,
      "stream": true,
      "fallbacks": [
        {
          "system_prepend": "@system_prompts/Haiku",
          "provider": "nvidia",
          "model": "deepseek-ai/deepseek-v4-flash",
          "temperature": 1.0,
          "top_p": 0.95,
          "max_tokens": 26000,
          "stream": true
        }
      ]
    }
  }
}